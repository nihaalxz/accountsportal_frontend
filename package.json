{
	"name": "accountsportal-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"build:wwwroot": "powershell -Command \"Remove-Item -Recurse -Force .svelte-kit -ErrorAction SilentlyContinue; npx svelte-kit sync; npx vite build; New-Item -ItemType Directory -Force ../accountsportal_backend/accountsportal_backend/src/TexasAccountsPortal.Api/wwwroot; Copy-Item -Recurse -Force build/* ../accountsportal_backend/accountsportal_backend/src/TexasAccountsPortal.Api/wwwroot/\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/vite": "^4.3.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.7.0",
		"eslint-plugin-svelte": "^3.20.0",
		"jsdom": "^29.1.1",
		"lucide-svelte": "^1.0.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@microsoft/signalr": "^10.0.0"
	}
}
